{"surah":{"number":113,"name":"سُورَةُ الفَلَقِ","englishName":"Al-Falaq","numberOfAyahs":5,"revelationType":"Meccan"},"verses":[{"number":1,"text":"قُلْ أَعُوذُ بِرَبِّ ٱلْفَلَقِ","tafsir":"قل -أيها الرسول-: أعوذ وأعتصم برب الفلق، وهو الصبح.","page":604,"juz":30,"hizb":240,"sajda":false},{"number":2,"text":"مِن شَرِّ مَا خَلَقَ","tafsir":"من شر جميع المخلوقات وأذاها.","page":604,"juz":30,"hizb":240,"sajda":false},{"number":3,"text":"وَمِن شَرِّ غَاسِقٍ إِذَا وَقَبَ","tafsir":"ومن شر ليل شديد الظلمة إذا دخل وتغلغل، وما فيه من الشرور والمؤذيات.","page":604,"juz":30,"hizb":240,"sajda":false},{"number":4,"text":"وَمِن شَرِّ ٱلنَّفَّٰثَٰتِ فِى ٱلْعُقَدِ","tafsir":"ومن شر الساحرات اللاتي ينفخن فيما يعقدن من عُقَد بقصد السحر.","page":604,"juz":30,"hizb":240,"sajda":false},{"number":5,"text":"وَمِن شَرِّ حَاسِدٍ إِذَا حَسَدَ","tafsir":"ومن شر حاسد مبغض للناس إذا حسدهم على ما وهبهم الله من نعم، وأراد زوالها عنهم، وإيقاع الأذى بهم.","page":604,"juz":30,"hizb":240,"sajda":false}]}