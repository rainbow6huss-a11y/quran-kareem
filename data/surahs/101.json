{"surah":{"number":101,"name":"سُورَةُ القَارِعَةِ","englishName":"Al-Qaari'a","numberOfAyahs":11,"revelationType":"Meccan"},"verses":[{"number":1,"text":"ٱلْقَارِعَةُ","tafsir":"الساعة التي تقرع قلوب الناس بأهوالها.","page":600,"juz":30,"hizb":240,"sajda":false},{"number":2,"text":"مَا ٱلْقَارِعَةُ","tafsir":"أيُّ شيء هذه القارعة؟","page":600,"juz":30,"hizb":240,"sajda":false},{"number":3,"text":"وَمَآ أَدْرَىٰكَ مَا ٱلْقَارِعَةُ","tafsir":"وأيُّ شيء أعلمك بها؟","page":600,"juz":30,"hizb":240,"sajda":false},{"number":4,"text":"يَوْمَ يَكُونُ ٱلنَّاسُ كَٱلْفَرَاشِ ٱلْمَبْثُوثِ","tafsir":"في ذلك اليوم يكون الناس في كثرتهم وتفرقهم وحركتهم كالفراش المنتشر، وهو الذي يتساقط في النار.","page":600,"juz":30,"hizb":240,"sajda":false},{"number":5,"text":"وَتَكُونُ ٱلْجِبَالُ كَٱلْعِهْنِ ٱلْمَنفُوشِ","tafsir":"وتكون الجبال كالصوف متعدد الألوان الذي يُنْفَش باليد، فيصير هباء ويزول.","page":600,"juz":30,"hizb":240,"sajda":false},{"number":6,"text":"فَأَمَّا مَن ثَقُلَتْ مَوَٰزِينُهُۥ","tafsir":"فأما من رجحت موازين حسناته، فهو في حياة مرضية في الجنة.","page":600,"juz":30,"hizb":240,"sajda":false},{"number":7,"text":"فَهُوَ فِى عِيشَةٍۢ رَّاضِيَةٍۢ","tafsir":"فأما من رجحت موازين حسناته، فهو في حياة مرضية في الجنة.","page":600,"juz":30,"hizb":240,"sajda":false},{"number":8,"text":"وَأَمَّا مَنْ خَفَّتْ مَوَٰزِينُهُۥ","tafsir":"وأما من خفت موازين حسناته، ورجحت موازين سيئاته، فمأواه جهنم.","page":600,"juz":30,"hizb":240,"sajda":false},{"number":9,"text":"فَأُمُّهُۥ هَاوِيَةٌۭ","tafsir":"وأما من خفت موازين حسناته، ورجحت موازين سيئاته، فمأواه جهنم.","page":600,"juz":30,"hizb":240,"sajda":false},{"number":10,"text":"وَمَآ أَدْرَىٰكَ مَا هِيَهْ","tafsir":"وما أدراك -أيها الرسول- ما هذه الهاوية؟","page":600,"juz":30,"hizb":240,"sajda":false},{"number":11,"text":"نَارٌ حَامِيَةٌۢ","tafsir":"إنها نار قد حَمِيت من الوقود عليها.","page":600,"juz":30,"hizb":240,"sajda":false}]}