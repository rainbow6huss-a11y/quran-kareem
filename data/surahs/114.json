{"surah":{"number":114,"name":"سُورَةُ النَّاسِ","englishName":"An-Naas","numberOfAyahs":6,"revelationType":"Meccan"},"verses":[{"number":1,"text":"قُلْ أَعُوذُ بِرَبِّ ٱلنَّاسِ","tafsir":"قل -أيها الرسول-: أعوذ وأعتصم برب الناس، القادر وحده على ردِّ شر الوسواس.","page":604,"juz":30,"hizb":240,"sajda":false},{"number":2,"text":"مَلِكِ ٱلنَّاسِ","tafsir":"ملك الناس المتصرف في كل شؤونهم، الغنيِّ عنهم.","page":604,"juz":30,"hizb":240,"sajda":false},{"number":3,"text":"إِلَٰهِ ٱلنَّاسِ","tafsir":"إله الناس الذي لا معبود بحق سواه.","page":604,"juz":30,"hizb":240,"sajda":false},{"number":4,"text":"مِن شَرِّ ٱلْوَسْوَاسِ ٱلْخَنَّاسِ","tafsir":"من أذى الشيطان الذي يوسوس عند الغفلة، ويختفي عند ذكر الله.","page":604,"juz":30,"hizb":240,"sajda":false},{"number":5,"text":"ٱلَّذِى يُوَسْوِسُ فِى صُدُورِ ٱلنَّاسِ","tafsir":"الذي يبثُّ الشر والشكوك في صدور الناس.","page":604,"juz":30,"hizb":240,"sajda":false},{"number":6,"text":"مِنَ ٱلْجِنَّةِ وَٱلنَّاسِ","tafsir":"من شياطين الجن والإنس.","page":604,"juz":30,"hizb":240,"sajda":false}]}